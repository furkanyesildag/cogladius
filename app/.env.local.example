# Cogladius — Stellar MAINNET configuration
# Copy to .env.local and fill in the server secrets. NEXT_PUBLIC_* are safe to expose.

# ── Stellar network (public / mainnet) ──
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org
# Leave NEXT_PUBLIC_SOROBAN_RPC_URL unset to route the client through the
# same-origin /api/soroban proxy (keeps the RPC secret token off the browser).
# NEXT_PUBLIC_SOROBAN_RPC_URL=

# ── Deployed contracts (Stellar mainnet) ──
# Live escrow, wired to the NATIVE XLM SAC (reward asset = XLM, no trustline needed).
NEXT_PUBLIC_ESCROW_CONTRACT_ID=CAC5EDF76M5LY43BNHT47Y5NZRHO4ZRH7SRFPNHATGNKN2DI3SNK75PL
# NOTE: the NEXT_PUBLIC_USDC_* names are legacy — they carry the reward asset,
# which on the live deployment is native XLM, not USDC.
NEXT_PUBLIC_USDC_SAC_ID=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
# Native XLM has no issuer; leave unset unless you redeploy against an issued asset.
# NEXT_PUBLIC_USDC_ISSUER=

# ── Agent API (optional, local agent runner) ──
NEXT_PUBLIC_AGENT_API_URL=http://localhost:3002

# ── Server-only secrets (never commit real values, never prefix NEXT_PUBLIC) ──
# Mainnet Soroban RPC URL — carries a secret token, so keep it server-side only.
SOROBAN_RPC_URL_SERVER=https://mainnet.stellar.validationcloud.io/v1/<TOKEN>
# Verdict authority: its raw ed25519 public key is baked into the contract config.
VERDICT_AUTHORITY_SECRET=S...
# Submitter: a funded mainnet account that pays fees / is the source for release_to_winner.
SOROBAN_SUBMITTER_SECRET=S...
# Optional fallback winner address if an agent has no Stellar address on file.
STELLAR_DEFAULT_WINNER=G...

# ── Optional: LLM judges (real 3-judge panel) ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Optional: persistence + admin ──
# DATABASE_URL=            # Postgres (Neon); set edilirse Upstash yerine kullanılır
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ADMIN_SECRET=

# ── Optional: Gladiator Passport (both routes return 503 until the first three are set) ──
# PASSPORT_CONTRACT_ID=C...
# ed25519 key whose public half is the contract's attestor. Needs no funding.
# PASSPORT_ATTESTOR_SECRET=S...
# Funded account that pays the fees. Keep it separate from SOROBAN_SUBMITTER_SECRET and hold only a limited balance.
# PASSPORT_SUBMITTER_SECRET=S...
# Refused on Stellar mainnet unless this is exactly "true".
# PASSPORT_ALLOW_MAINNET=
# Defaults: 500000000 (50 XLM a UTC day) and 2000000 (0.2 XLM per transaction).
# PASSPORT_DAILY_CAP_STROOPS=
# PASSPORT_MAX_TX_FEE_STROOPS=
