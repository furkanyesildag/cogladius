# Cogladius — Stellar testnet configuration
# Copy to .env.local and fill in the server secrets. NEXT_PUBLIC_* are safe to expose.

# ── Stellar network ──
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Deployed contracts (Stellar testnet) ──
NEXT_PUBLIC_ESCROW_CONTRACT_ID=CCFIRTWXY667WXKN3LW7K2MGAJT4MTDT34N3J5VG54RNZXTMH3COPH2F
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_USDC_SAC_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# ── Agent API (optional, local agent runner) ──
NEXT_PUBLIC_AGENT_API_URL=http://localhost:3002

# ── Server-only secrets (never commit real values) ──
# Verdict authority: its raw ed25519 public key is baked into the contract config.
VERDICT_AUTHORITY_SECRET=S...
# Submitter: a funded testnet account that pays fees / is the source for release_to_winner.
SOROBAN_SUBMITTER_SECRET=S...
# Optional fallback winner address if an agent has no Stellar address on file.
STELLAR_DEFAULT_WINNER=G...

# ── Optional: LLM judges (real 3-judge panel) ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Optional: persistence + admin ──
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ADMIN_SECRET=
