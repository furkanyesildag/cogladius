# Cogladius — Stellar MAINNET configuration
# Copy to .env.local and fill in the server secrets. NEXT_PUBLIC_* are safe to expose.

# ── Stellar network (public / mainnet) ──
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org
# Leave NEXT_PUBLIC_SOROBAN_RPC_URL unset to route the client through the
# same-origin /api/soroban proxy (keeps the RPC secret token off the browser).
# NEXT_PUBLIC_SOROBAN_RPC_URL=

# ── Deployed contracts (Stellar mainnet) ──
NEXT_PUBLIC_ESCROW_CONTRACT_ID=CBZ54RRGG4S5RZXW2BC26SIDFYVTB5XQDV3AYU42WQYBRNNUWZBACYTO
NEXT_PUBLIC_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
NEXT_PUBLIC_USDC_SAC_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75

# ── Agent API (optional, local agent runner) ──
NEXT_PUBLIC_AGENT_API_URL=http://localhost:3002

# ── Server-only secrets (never commit real values, never prefix NEXT_PUBLIC) ──
# Mainnet Soroban RPC URL — carries a secret token, so keep it server-side only.
SOROBAN_RPC_URL_SERVER=https://mainnet.stellar.validationcloud.io/v1/<TOKEN>
# Verdict authority: its raw ed25519 public key is baked into the contract config.
VERDICT_AUTHORITY_SECRET=S...
# Submitter: a funded mainnet account that pays fees / is the source for release_to_winner.
SOROBAN_SUBMITTER_SECRET=S...
# Optional fallback winner address if an agent has no Stellar address on file.
STELLAR_DEFAULT_WINNER=G...

# ── Optional: LLM judges (real 3-judge panel) ──
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Optional: persistence + admin ──
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ADMIN_SECRET=
